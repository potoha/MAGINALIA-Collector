{
  "manifest_version": 3,
  "name": "MAGINALIA Collector",
  "version": "0.3.0",
  "description": "Webページで選択した引用と出典を確認し、MAGINALIAで設定したPrivate Shelfに保存します。保存にはMAGINALIA連携プログラムが必要です。",
  "key": "",
  "permissions": [
    "activeTab",
    "contextMenus",
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "MAGINALIA Collector",
    "default_popup": "popup.html",
    "default_icon": "icon..png"
  },
  "icons": {
    "16": "icon..png",
    "48": "icon..png",
    "128": "icon..png"
  }
}
