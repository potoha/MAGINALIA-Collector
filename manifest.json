{
  "manifest_version": 3,
  "name": "MAGINALIA Collector",
  "version": "0.1.0",
  "description": "選択した引用と出典を確認するための拡張機能です。保存連携は未実装です。",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "MAGINALIA Collector — 準備中",
    "default_popup": "popup.html",
    "default_icon": "icon..png"
  },
  "icons": {
    "16": "icon..png",
    "48": "icon..png",
    "128": "icon..png"
  }
}
